APP_NAME="Bistro Suite API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
ADMIN_DEMO_READ_ONLY=false
ADMIN_DEMO_READ_ONLY_MESSAGE="Modo demo: no está permitido modificar, agregar ni quitar información."
APP_URL=http://localhost:8000
APP_LOCALE=es
APP_FAKER_LOCALE=es_CO

LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=bistro_suite
DB_USERNAME=bistro
DB_PASSWORD=local-demo-only

# Set APP_KEY with `php artisan key:generate` for local use.
